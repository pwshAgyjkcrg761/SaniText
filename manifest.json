{
  "manifest_version": 3,
  "name": "SaniText v2026.07.02__13.29.45",
  "description": "A utility to copy selection as clean plain text with advanced filename sanitization and formatting options.",
  "version": "2026.7.2.48585",
  "icons": {
    "16": "icons/sanitext-icon-16x16.png",
    "32": "icons/sanitext-icon-32x32.png",
    "48": "icons/sanitext-icon-48x48.png",
    "128": "icons/sanitext-icon-128x128.png"
  },
  "permissions": ["contextMenus", "storage", "clipboardWrite", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
  
}